# 复制为 .env 并填入。.env 不要提交到 git

# --- LLM(二选一)---
LLM_PROVIDER=openai            # openai | anthropic
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Slack(Socket Mode)---
SLACK_BOT_TOKEN=xoxb-...       # OAuth & Permissions 里的 Bot User Token
SLACK_APP_TOKEN=xapp-...       # Basic Information → App-Level Token(connections:write)
SLACK_REMINDER_CHANNEL=        # 提醒发到哪:频道ID(C..)或用户ID(U..)
